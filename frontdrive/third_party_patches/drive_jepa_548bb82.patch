+def make_lr_lambda(schedule: str, total_steps: int, min_mult: float = 0.1, warmup_steps: int = 0):
+    """frontdrive ④(b): multiplicative lr factor per optimizer step. 'cosine': linear warm-up (if any) then cosine from 1 to
+    min_mult at total_steps and min_mult afterwards; 'step': 1 until 75 % of total_steps then min_mult."""
+    if total_steps <= 0:
+        raise ValueError("lr_schedule requires lr_total_steps > 0 (optimizer steps of the whole run)")
+    import math
+
+    def lam(step: int) -> float:
+        if warmup_steps > 0 and step < warmup_steps:
+            return (step + 1) / warmup_steps
+        t = min(max(step - warmup_steps, 0), max(total_steps - warmup_steps, 1))
+        frac = t / max(total_steps - warmup_steps, 1)
+        if schedule == "cosine":
+            return min_mult + (1.0 - min_mult) * 0.5 * (1.0 + math.cos(math.pi * frac))
+        if schedule == "step":
+            return 1.0 if frac < 0.75 else min_mult
+        raise ValueError(f"unknown lr_schedule {schedule!r}")
+
+    return lam
+
